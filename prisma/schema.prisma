generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Course {
  id             String   @id @default(cuid())
  nameEt         String
  nameEn         String
  county         String
  city           String?
  latitude       Float
  longitude      Float
  descriptionEt  String?  @db.Text
  descriptionEn  String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  holes    Hole[]
  checkIns CheckIn[]
  issues   IssueReport[]
  admins   CourseAdmin[]
}

model Hole {
  id       String @id @default(cuid())
  courseId String
  number   Int
  par      Int
  distance Int?

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, number])
}

model CheckIn {
  id                String    @id @default(cuid())
  courseId          String
  deviceId          String
  partySize         Int       @default(1)
  startedAt         DateTime  @default(now())
  lastPingAt        DateTime  @default(now())
  endedAt           DateTime?
  // Throttle bookkeeping for the push worker: last time we sent a periodic
  // reminder, and whether we've already sent the pre-checkout warning.
  lastReminderAt    DateTime?
  warningSentAt     DateTime?

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, endedAt])
  @@index([deviceId, endedAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  deviceId  String
  endpoint  String   @unique @db.VarChar(500)
  p256dh    String   @db.VarChar(200)
  auth      String   @db.VarChar(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deviceId])
}

model IssueReport {
  id        String   @id @default(cuid())
  courseId  String?
  category  String
  message   String   @db.Text
  deviceId  String?
  status    String   @default("open")
  createdAt DateTime @default(now())

  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

model Admin {
  id           String    @id @default(cuid())
  email        String    @unique
  // Display name shown in the header; falls back to email when null.
  name         String?   @db.VarChar(100)
  passwordHash String
  role         String
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  courses     CourseAdmin[]
  logins      AdminLoginEvent[]
  resetTokens PasswordResetToken[]
}

// One row per successful admin sign-in. Pruned after a year (see
// recordLogin in src/lib/admin.ts).
model AdminLoginEvent {
  id        String   @id @default(cuid())
  adminId   String
  ip        String?  @db.VarChar(64)
  userAgent String?  @db.VarChar(300)
  createdAt DateTime @default(now())

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, createdAt])
}

// Single-use password reset link. Only the SHA-256 of the token is stored,
// so a DB leak doesn't hand out working reset links.
model PasswordResetToken {
  id        String    @id @default(cuid())
  adminId   String
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
}

model CourseAdmin {
  courseId  String
  adminId   String
  createdAt DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  admin  Admin  @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@id([courseId, adminId])
  @@index([adminId])
}
